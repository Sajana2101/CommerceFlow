{
  "ConnectionStrings": {
    "CommerceFlowDatabase": "Server=(localdb)\\MSSQLLocalDB;Database=CommerceFlowDb;Trusted_Connection=True;TrustServerCertificate=True"
  },

  "Jwt": {
    "Issuer": "CommerceFlow.Api",
    "Audience": "CommerceFlow.Client",
    "ExpirationMinutes": 60
  },

  "Redis": {
    "Configuration": "localhost:6379",
    "InstanceName": "CommerceFlow:"
  },
  "RabbitMq": {
    "HostName": "localhost",
    "Port": 5672,
    "UserName": "guest",
    "Password": "guest",
    "ExchangeName": "commerceflow.events"
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}